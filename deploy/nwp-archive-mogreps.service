# systemd user unit: one MOGREPS-UK recording cycle. The timer starts it every 30 minutes.
# Install: copy this file and nwp-archive-mogreps.timer to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now nwp-archive-mogreps.timer
# Settings (ARCHIVE_STORE_ROOT, optionally SENTRY_DSN) go in ~/.config/nwp-archive.env, which the
# DWD service reads too. This service has its own cache directory, and so its own lock, so that a
# long MOGREPS-UK backfill never makes the DWD service skip a cycle.
[Unit]
Description=Record one cycle of the MOGREPS-UK ensemble

[Service]
Type=oneshot
WorkingDirectory=%h/dev/nwp-archivist
EnvironmentFile=-%h/.config/nwp-archive.env
# A cycle handles the live runs first and then spends at most --backfill-minutes on older runs
# that are still in the bucket (which keeps a run for about 30 days). Two workers download files
# for the older runs, so that the backfill's request rate stays modest.
ExecStart=%h/dev/nwp-archivist/.venv/bin/archive-record --products mogreps-uk --cache-dir /mnt/data/nwp-archive-cache-mogreps --backfill-minutes 15
TimeoutStartSec=infinity
Nice=10
