# systemd user unit: one MOGREPS-UK recording cycle. The timer starts the next 1 minute after.
# Install: copy this file and nwp-archive-mogreps.timer to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now nwp-archive-mogreps.timer
# Settings (ARCHIVE_STORE_ROOT, optionally SENTRY_DSN) go in ~/.config/nwp-archive.env, which the
# DWD service reads too. This service has its own cache directory, and so its own lock, so that a
# long MOGREPS-UK backfill never makes the DWD service skip a cycle.
[Unit]
Description=Record one cycle of the MOGREPS-UK ensemble

[Service]
Type=oneshot
WorkingDirectory=%h/dev/nwp-archivist
EnvironmentFile=-%h/.config/nwp-archive.env
# A cycle handles the live runs first and then spends at most --backfill-minutes on older runs that
# are still in the bucket (which keeps a run for about 30 days), oldest first. Four worker processes fetch the files, because h5py's global lock stops threads
# from speeding up the chunk-index reads; only this main process writes to the repository. The timer starts the
# next cycle 1 minute after this one exits, so the backfill goes on in 10-minute slices and a new
# run waits at most one slice.
ExecStart=%h/dev/nwp-archivist/.venv/bin/archive-record --products mogreps-uk --cache-dir /mnt/data/nwp-archive-cache-mogreps --backfill-minutes 10 --fetch-processes 4
# A hung cycle is killed after 3 hours. The cache directory's lock stops two cycles overlapping.
TimeoutStartSec=3h
# Four worker processes and the main process hold cropped runs of about 0.5 GB each in memory.
MemoryMax=20G
TasksMax=64
Nice=10
