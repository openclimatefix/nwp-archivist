# systemd user unit: one MOGREPS-G recording cycle. The timer starts the next 1 minute after.
# Install: copy this file and nwp-archive-mogreps-g.timer to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now nwp-archive-mogreps-g.timer
# Settings (ARCHIVE_STORE_ROOT, optionally SENTRY_DSN) go in ~/.config/nwp-archive.env, which the
# other services read too. This service has its own cache directory, and so its own lock, so that a
# long MOGREPS-G backfill never makes the DWD or MOGREPS-UK services skip a cycle.
# --backfill-urgency-file names a file shared only with the MOGREPS-UK unit (see
# nwp_archivist.backfill_urgency): whichever product is closer to losing a run to the bucket's
# 30-day retention gets a cycle's backfill slice. The DWD unit does not pass this flag, so it never
# reads or writes that file.
[Unit]
Description=Record one cycle of the MOGREPS-G ensemble

[Service]
Type=oneshot
WorkingDirectory=%h/dev/nwp-archivist
EnvironmentFile=-%h/.config/nwp-archive.env
# A cycle handles the live runs first and then spends at most --backfill-minutes on older runs that
# are still in the bucket (which keeps a run for about 30 days), oldest first. Four worker processes
# fetch the files, because h5py's global lock stops threads from speeding up the chunk-index reads;
# only this main process writes to the repository. The timer starts the next cycle 1 minute after
# this one exits, so the backfill goes on in 10-minute slices and a new run waits at most one slice.
ExecStart=%h/dev/nwp-archivist/.venv/bin/archive-record --products mogreps-g --cache-dir /mnt/data/nwp-archive-cache-mogreps-g --backfill-minutes 10 --fetch-processes 4 --backfill-urgency-file /mnt/data/nwp-archive-backfill-urgency-mogreps.json
# A hung cycle is killed after 3 hours. The cache directory's lock stops two cycles overlapping.
TimeoutStartSec=3h
# Four worker processes and the main process hold cropped runs in memory; MOGREPS-G's crop is far
# smaller per file than MOGREPS-UK's (thousands of cells, not tens of thousands), so the limit is
# lower than MOGREPS-UK's.
MemoryMax=8G
TasksMax=512
# Each worker process would start one numerical-library thread per core, which exhausted the task
# limit.
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
Nice=10
